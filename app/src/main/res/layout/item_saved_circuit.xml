<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#333333"
    android:padding="12dp">

    <!-- Circuit Thumbnail -->
    <ImageView
        android:id="@+id/circuit_thumbnail"
        android:layout_width="80dp"
        android:layout_height="60dp"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:background="#222222"
        android:scaleType="centerCrop"
        android:contentDescription="Circuit thumbnail" />

    <!-- Action Buttons Container -->
    <LinearLayout
        android:id="@+id/action_buttons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:orientation="horizontal">

        <!-- Duplicate Button -->
        <ImageView
            android:id="@+id/duplicate_button"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="4dp"
            android:padding="8dp"
            android:src="@drawable/ic_duplicate"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Duplicate circuit" />

        <!-- Delete Button -->
        <ImageView
            android:id="@+id/delete_button"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="8dp"
            android:src="@drawable/ic_delete"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Delete circuit" />

    </LinearLayout>

    <!-- Circuit Info Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/circuit_thumbnail"
        android:layout_toStartOf="@id/action_buttons"
        android:layout_centerVertical="true"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical">

        <!-- Circuit Name -->
        <TextView
            android:id="@+id/circuit_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Circuit Name"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- Circuit Info (components, wires) -->
        <TextView
            android:id="@+id/circuit_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="0 components, 0 wires"
            android:textColor="#AAAAAA"
            android:textSize="12sp" />

        <!-- Date -->
        <TextView
            android:id="@+id/circuit_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Jan 01, 2025"
            android:textColor="#888888"
            android:textSize="11sp" />

    </LinearLayout>

</RelativeLayout>
